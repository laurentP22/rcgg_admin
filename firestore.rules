rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'laurent22100@gmail.com';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasApprovedProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().status == 'approved';
    }

    function isAdmin() {
      return isBootstrapAdmin() || (hasApprovedProfile() && getUserData().role == 'Admin');
    }

    function isApprovedUser() {
      return isBootstrapAdmin() || hasApprovedProfile();
    }

    function isValidClub(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    function isValidEvent(data) {
      return data.nom is string && data.nom.size() > 0 && data.nom.size() <= 200
        && data.type is string && data.type.size() <= 50
        && data.cat is string && data.cat.size() <= 100
        && (!('lieu' in data) || (data.lieu is string && data.lieu.size() <= 200))
        && (!('horaire' in data) || (data.horaire is string && data.horaire.size() <= 100))
        && (!('adversaire' in data) || (data.adversaire is string && data.adversaire.size() <= 200))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('materiel' in data) || (data.materiel is list && data.materiel.size() <= 100))
        && (!('todo' in data) || (data.todo is list && data.todo.size() <= 100))
        && (!('benevoles' in data) || (data.benevoles is list && data.benevoles.size() <= 100))
        && (!('com' in data) || (data.com is list && data.com.size() <= 100));
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 200
        && (data.role in ['Admin', 'Benevole', 'Joueur'])
        && (data.status in ['pending', 'approved', 'rejected', 'deactivated']);
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      
      // Self registration (bootstrap admin gets auto-approved Admin, others get pending), or Admin can create members/samples
      allow create: if isValidId(userId) && isSignedIn() && (
        (isAdmin() && isValidUserProfile(request.resource.data)) ||
        (request.auth.uid == userId && isValidUserProfile(request.resource.data) && (
          (isBootstrapAdmin() && request.resource.data.role == 'Admin' && request.resource.data.status == 'approved') ||
          (!isBootstrapAdmin() && request.resource.data.status == 'pending' && request.resource.data.role in ['Benevole', 'Joueur'])
        ))
      );

      // Updates: Admins can update roles/status; users can only update display info
      allow update: if isValidId(userId) && isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && isValidUserProfile(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']))
      );

      allow delete: if isValidId(userId) && isSignedIn() && isAdmin();
    }

    // Club configuration
    match /clubs/{clubId} {
      allow get: if isValidId(clubId) && isSignedIn();
      allow list: if isSignedIn();
      allow write: if isValidId(clubId) && isAdmin() && isValidClub(request.resource.data);
    }

    // Matches and events
    match /events/{eventId} {
      allow get: if isValidId(eventId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(eventId) && isAdmin() && isValidEvent(request.resource.data);
      allow update: if isValidId(eventId) && isAdmin() && isValidEvent(request.resource.data);
      allow delete: if isValidId(eventId) && isAdmin();
    }
  }
}
